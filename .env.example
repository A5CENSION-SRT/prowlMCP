# Docker user and timezone
PUID=1000
PGID=1000
TZ=Asia/Kolkata

# Host ports for Web UIs
PROWLARR_PORT=11111
QBITTORRENT_PORT=11112

# Config folder and download path
CONFIG_PATH=~/.config
DOWNLOADS_PATH=~/Documents/ProwlDownloads

# Prowlarr API connection
PROWLARR_URL=http://localhost:11111
PROWLARR_API_KEY=your_prowlarr_api_key_here

# qBittorrent WebUI connection
QBITTORRENT_URL=http://localhost:11112
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=your_qbittorrent_password_here
QBITTORRENT_SAVE_PATH=/downloads

# Server library folders
TV_LIBRARY_PATH=/media/TV
MOVIES_LIBRARY_PATH=/media/Movies

# Jellyfin server connection (SSH)
SSH_HOST=your_server_address_here
SSH_PORT=22
SSH_USER=your_ssh_user_here
SSH_KEY_PATH=~/.ssh/your_key_file_here

# Jellyfin API connection
JELLYFIN_URL=http://your_server_address_here:8096
JELLYFIN_API_KEY=your_jellyfin_api_key_here

# App settings
REQUEST_TIMEOUT=30
LOG_LEVEL=INFO
MAX_SEARCH_QUERIES=3
SEARCH_RESULTS_PER_QUERY=10
METADATA_TIMEOUT_SECONDS=60
RESUME_CHECK_SECONDS=10
METADATA_POLL_SECONDS=2
QBITTORRENT_NO_ETA=8640000
QBITTORRENT_TAG=prowl
DEFAULT_SEARCH_LIMIT=20
PROWLARR_INDEXER_IDS=-2
QBITTORRENT_PROCESSED_TAG=processed
COMPLETION_CHECK_SECONDS=300
