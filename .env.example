# Docker user and timezone
PUID=1000
PGID=1000
TZ=Asia/Kolkata

# Host ports for Web UIs
PROWLARR_PORT=11111
QBITTORRENT_PORT=11112

# Config folder and download path
CONFIG_PATH=~/.config
DOWNLOADS_PATH=~/Documents/ProwlDownloads

# Prowlarr API connection
PROWLARR_URL=http://localhost:11111
PROWLARR_API_KEY=your_prowlarr_api_key_here

# qBittorrent WebUI connection
QBITTORRENT_URL=http://localhost:11112
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=your_qbittorrent_password_here

# App settings
REQUEST_TIMEOUT=30
LOG_LEVEL=INFO
MAX_SEARCH_QUERIES=3
SEARCH_RESULTS_PER_QUERY=10